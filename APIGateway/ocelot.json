{
  "Routes": [
    {
      "UpstreamPathTemplate": "/health",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/health",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "auth-api", "Port": 8081 }]
    },
    {
      "UpstreamPathTemplate": "/api/auth/health",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/health",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "auth-api", "Port": 8081 }]
    },
    // 1. АУТЕНТИФИКАЦИЯ (AuthService - Порт 8081)
    {
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-api",
          "Port": 8081
        }
      ],
      "AddHeadersToRequest": { "X-Forwarded-Host": "{Request.Host}" }
    },
    {
      "UpstreamPathTemplate": "/api/signin-github",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/signin-github",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "auth-api", "Port": 8081 }]
    },

    // 2. ПОЛЬЗОВАТЕЛИ: Регистрация (UserService - 8082, без авторизации)
    {
      "UpstreamPathTemplate": "/api/users/create",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/users/create",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "user-api", "Port": 8082 }]
    },

    // 3. ПОЛЬЗОВАТЕЛИ: Аккаунт и управление (UserService - 8082, НУЖЕН ТОКЕН)
    {
      "UpstreamPathTemplate": "/api/users/{url}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/users/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "user-api", "Port": 8082 }],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" },
      "AddHeadersToRequest": {
        "X-User-Id": "Claims[http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier] > value"
      }
    },

    // 4. ПАРОЛИ: Сброс (PasswordService - 8084, без авторизации)
    {
      "UpstreamPathTemplate": "/api/passwords/reset/{everything}",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/passwords/reset/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "password-api", "Port": 8084 }]
    },

    // 5. ПАРОЛИ: Обновление (PasswordService - 8084, НУЖЕН ТОКЕН)
    {
      "UpstreamPathTemplate": "/api/passwords/update",
      "UpstreamHttpMethod": [ "PUT" ],
      "DownstreamPathTemplate": "/passwords/update",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "password-api", "Port": 8084 }],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" },
      "AddHeadersToRequest": {
        "X-User-Id": "Claims[http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier] > value"
      }
    },

    // 6. ПОДПИСКИ (SubscribeService - 8085, НУЖЕН ТОКЕН)
    {
      "UpstreamPathTemplate": "/api/subscribes/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/subscribes/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "subscribe-api", "Port": 8085 }],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" },
      "AddHeadersToRequest": {
        "X-User-Id": "Claims[http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier] > value"
      }
    },

    // 7. ЗАДАЧИ СКАНИРОВАНИЯ (TaskService - 8086, НУЖЕН ТОКЕН)
    {
      "UpstreamPathTemplate": "/api/task/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE" ],
      "DownstreamPathTemplate": "/task/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "task-api", "Port": 8086 }],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" },
      "AddHeadersToRequest": {
        "X-User-Id": "Claims[http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier] > value"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8080"
  }
}